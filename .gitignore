
import streamlit as st
import requests
from bs4 import BeautifulSoup
from urllib.parse import urljoin, urlparse
import time

class DeepSearchEngine:
    def __init__(self, start_urls, max_depth=2):
        self.start_urls = start_urls
        self.max_depth = max_depth
        self.visited_urls = set()
        self.headers = {'User-Agent': '# YOU CAN USE YOUR OWN AGENT'}
        self.results = []

    def get_domain(self, url):
        return urlparse(url).netloc

    def crawl_and_search(self, url, target_word, current_depth, status_placeholder):
        if current_depth > self.max_depth or url in self.visited_urls:
            return
        
        self.visited_urls.add(url)
        status_placeholder.text(f"Scanning [Depth {current_depth}]: {url}")

        try:
            response = requests.get(url, headers=self.headers, timeout=3)
            if response.status_code != 200:
                return

            soup = BeautifulSoup(response.text, 'html.parser')
            all_text = soup.get_text().lower()
            count = all_text.count(target_word.lower())
            
            if count > 0:
                title = soup.title.string.strip() if soup.title else url
                self.results.append({
                    'title': title,
                    'url': url,
                    'matches': count,
                })

            if current_depth < self.max_depth:
                main_domain = self.get_domain(url)
                for link_tag in soup.find_all('a', href=True):
                    href = link_tag['href']
                    full_url = urljoin(url, href)
                    if self.get_domain(full_url) == main_domain:
                        self.crawl_and_search(full_url, target_word, current_depth + 1, status_placeholder)
        except Exception:
            pass

    def start_search(self, target_word, status_placeholder):
        for url in self.start_urls:
            self.crawl_and_search(url, target_word, 1, status_placeholder)
        return self.results

# --- UI Layout ---
st.set_page_config(page_title="Deep Web Search Engine", page_icon="🔍", layout="centered")

st.markdown("""
    <style>
    .main-title { font-size: 42px; font-weight: 700; color: #1E88E5; text-align: center; margin-bottom: 10px; }
    .sub-title { font-size: 16px; color: #666; text-align: center; margin-bottom: 30px; }
    .result-card { padding: 15px; border-radius: 8px; border: 1px solid #E0E0E0; margin-bottom: 15px; background-color: #F8F9FA; }
    .result-title { font-size: 18px; font-weight: 600; color: #1565C0; text-decoration: none; }
    .result-url { font-size: 13px; color: #2E7D32; margin-bottom: 5px; }
    .badge { background-color: #E3F2FD; color: #0D47A1; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; margin-right: 5px; }
    </style>
""", unsafe_allow_html=True)

st.markdown("<div class='main-title'>🔍 Deep Search Engine</div>", unsafe_allow_html=True)
st.markdown("<div class='sub-title'>Crawls into websites and indexes matches instantly</div>", unsafe_allow_html=True)

target_word = st.text_input("Enter Keyword to Search:", placeholder="e.g., machine learning")

with st.expander("⚙️ Crawler Settings"):
    max_depth = st.slider("Crawl Depth:", min_value=1, max_value=3, value=2)
    urls_input = st.text_area(
        "Target URLs (One URL per line):", 
        value="https://www.python.org\nhttps://www.w3schools.com/"
    )

if st.button("Start Deep Search", type="primary"):
    if not target_word.strip():
        st.warning("Please enter a keyword first!")
    elif not urls_input.strip():
        st.warning("Please enter at least one target URL!")
    else:
        target_urls = [url.strip() for url in urls_input.split('\n') if url.strip()]
        status_box = st.empty()
        
        engine = DeepSearchEngine(target_urls, max_depth=max_depth)
        
        start_time = time.time()
        with st.spinner("Crawling the web..."):
            results = engine.start_search(target_word, status_box)
        end_time = time.time()
        
        status_box.empty()
        st.success(f"Search completed in {end_time - start_time:.2f} seconds!")
        
        if len(results) == 0:
            st.info("No matches found.")
        else:
            for item in results:
                st.markdown(f"""
                    <div class="result-card">
                        <a href="{item['url']}" target="_blank" class="result-title">{item['title']}</a>
                        <div class="result-url">{item['url']}</div>
                        <span class="badge">Matches: {item['matches']}</span>
                        <span class="badge" style="background-color: #E8F5E9; color: #1B5E20;">Depth: {item['depth']}</span>
                    </div>
                """, unsafe_allow_html=True)
